@model IEnumerable<PawCare.Models.Mascota>

<h1>Lista de Mascotas</h1>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nombre Mascota</th>
            <th>Dueño</th>
            <th>Tipo</th>
            <th>Edad</th>
            <th>Teléfono</th>
            <th>Observaciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var mascota in Model)
        {
            <tr>
                <td>@mascota.Id</td>
                <td>@mascota.NombreMascota</td>
                <td>@mascota.NombreDueno</td>
                <td>@mascota.Tipo</td>
                <td>@mascota.Edad</td>
                <td>@mascota.Telefono</td>
                <td>@mascota.Observaciones</td>
            </tr>
        }
    </tbody>
</table>
