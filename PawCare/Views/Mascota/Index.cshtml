@model IEnumerable<PawCare.Models.Mascota>

<h1>Lista de Mascotas</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Nueva Mascota</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nombre Mascota</th>
            <th>Dueño</th>
            <th>Tipo</th>
            <th>Edad</th>
            <th>Teléfono</th>
            <th>Observaciones</th>
           <!-- <th>Acciones</th>-->
        </tr>
    </thead>
    <tbody>
        @foreach (var mascota in Model)
        {
            <tr>
                <td>@mascota.Id</td>
                <td>@mascota.NombreMascota</td>
                <td>@mascota.NombreDueno</td>
                <td>@mascota.Tipo</td>
                <td>@mascota.Edad</td>
                <td>@mascota.Telefono</td>
                <td>@mascota.Observaciones</td>
                <!--<td>
                    <a asp-action="Edit" asp-route-id="@mascota.Id">Editar</a> |
                    <a asp-action="Delete" asp-route-id="@mascota.Id">Eliminar</a>
                </td>-->
            </tr>
        }
    </tbody>
</table>